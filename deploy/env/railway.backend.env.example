# Canonical Railway production environment template for backend service.
# Source of truth for backend deployment env vars.

NODE_ENV=production
PORT=3001

# LLM provider (choose one: ollama|openai|anthropic|together|groq|gemini)
LLM_PROVIDER=groq

# Provider credentials/models
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional provider configs (only used if selected)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Stacks on-chain configuration
STACKS_NETWORK=mainnet
STACKS_API_URL=https://api.hiro.so
DAO_DEPLOYER_ADDRESS=SP1MTYHV6K2FNH3QNF4P5QXS9VJ3XZ0GBB5T1SJPK

# Optional registry override/default
DAO_FACTORY_CONTRACT_ID=SP1MTYHV6K2FNH3QNF4P5QXS9VJ3XZ0GBB5T1SJPK.dao-factory-v2-c4
DAO_DEFAULT_ID=1
