# Canonical Vercel production environment template for frontend service.
# Source of truth for frontend deployment env vars.

# Backend base URL (no trailing slash, no /api suffix)
VITE_API_URL=https://your-backend.up.railway.app

# Must match backend STACKS_NETWORK
VITE_STACKS_NETWORK=mainnet

# Optional WalletConnect support for mobile wallets
VITE_WALLETCONNECT_PROJECT_ID=
