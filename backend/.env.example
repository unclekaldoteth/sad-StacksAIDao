# AI Agent Configuration
# Copy this file to .env and fill in your values

# ===========================================
# LLM Provider Configuration
# ===========================================
# Options: ollama, openai, anthropic, together, groq, gemini
LLM_PROVIDER=ollama

# Ollama (Local LLM - Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Together AI (Optional)
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3-70b-chat-hf

# Groq (Optional - Fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (Optional - Free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===========================================
# Stacks Configuration
# ===========================================
STACKS_NETWORK=testnet
STACKS_API_URL=https://api.testnet.hiro.so
DAO_DEPLOYER_ADDRESS=ST1ZGGS886YCZHMFXJR1EK61ZP34FNWNSX28M1PMM

# Optional: on-chain DAO registry (dao-factory contract)
# If unset, backend defaults to `${DAO_DEPLOYER_ADDRESS}.dao-factory` (when DAO_DEPLOYER_ADDRESS is set).
DAO_FACTORY_CONTRACT_ID=

# Optional: default DAO id to select from the factory registry (e.g. "1")
DAO_DEFAULT_ID=

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development
